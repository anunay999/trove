{
  "name": "trove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/src/server.js",
    "start:container": "npm run db:migrate:prod && npm run start:prod",
    "cli": "tsx scripts/trove.ts",
    "cli:prod": "node dist/scripts/trove.js",
    "mcp": "tsx src/mcpServer.ts",
    "mcp:prod": "node dist/src/mcpServer.js",
    "mcp:test": "tsx scripts/testMcp.ts",
    "mcp:http:test": "tsx scripts/testMcpHttp.ts",
    "scribe:mcp:test": "tsx scripts/testScribeMcp.ts",
    "auth:test": "tsx scripts/testAuth.ts",
    "events:test": "tsx scripts/testEvents.ts",
    "retrieval:test": "tsx scripts/testRetrieval.ts",
    "recall:test": "tsx scripts/testRecall.ts",
    "sources:test": "tsx scripts/testSources.ts",
    "episodes:test": "tsx scripts/testEpisodes.ts",
    "bitemporal:test": "tsx scripts/testBitemporal.ts",
    "jobs:test": "tsx scripts/testJobs.ts",
    "views:test": "tsx scripts/testViews.ts",
    "jobs:run": "tsx scripts/runJobs.ts",
    "jobs:run:prod": "node dist/scripts/runJobs.js",
    "db:clean:smoke": "tsx scripts/cleanupSmokeData.ts",
    "db:schema": "tsx scripts/applySchema.ts",
    "db:migrate": "tsx scripts/applyMigrations.ts",
    "db:migrate:prod": "node dist/scripts/applyMigrations.js",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "export:obsidian": "tsx scripts/exportObsidianVault.ts",
    "export:obsidian:test": "tsx scripts/testObsidianExport.ts",
    "import:scribe": "tsx scripts/importScribeVault.ts",
    "typecheck": "tsc --noEmit",
    "worker:test": "tsx scripts/testJobWorker.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.27",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
