{
  "name": "trove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"if(require('fs').existsSync('web/package.json'))require('child_process').execSync('npm --prefix web install --no-audit --no-fund',{stdio:'inherit'})\"",
    "setup": "docker compose up -d --wait postgres && npm run db:schema && npm run db:migrate",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "dev:all": "npm run web:dev & npm run dev",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/src/server.js",
    "start:container": "npm run db:migrate:prod && npm run start:prod",
    "cli": "tsx scripts/trove.ts",
    "cli:prod": "node dist/scripts/trove.js",
    "mcp": "tsx src/mcpServer.ts",
    "mcp:prod": "node dist/src/mcpServer.js",
    "jobs:run": "tsx scripts/runJobs.ts",
    "jobs:run:prod": "node dist/scripts/runJobs.js",
    "db:clean:smoke": "tsx scripts/cleanupSmokeData.ts",
    "db:schema": "tsx scripts/applySchema.ts",
    "db:migrate": "tsx scripts/applyMigrations.ts",
    "db:migrate:prod": "node dist/scripts/applyMigrations.js",
    "db:reset": "docker compose down -v && npm run setup",
    "db:logs": "docker compose logs -f postgres",
    "web:dev": "npm --prefix web run dev",
    "web:build": "(test -d web/node_modules || npm --prefix web ci) && npm --prefix web run build",
    "export:obsidian": "tsx scripts/exportObsidianVault.ts",
    "import:vault": "tsx scripts/importScribeVault.ts",
    "import:scribe": "tsx scripts/importScribeVault.ts",
    "backfill:vault": "tsx scripts/backfillVaultContent.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npx oxlint src scripts tests",
    "check": "npm run typecheck && npm run lint",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"tests/**/*.test.ts\"",
    "test:e2e": "TROVE_E2E=1 node --import tsx --test \"tests/**/*.test.ts\"",
    "clean": "rm -rf dist web/dist",
    "rebuild": "npm run clean && npm run build && npm run web:build"
  },
  "dependencies": {
    "@clerk/backend": "^3.10.0",
    "@hono/node-server": "^2.0.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.27",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "oxlint": "^1.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
