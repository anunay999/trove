PORT=8787
DATABASE_URL=postgres://trove:trove@localhost:5433/trove
RAW_BLOB_BUCKET=trove-raw

# Optional locally. Required in production.
# Format: token|actor_id|scope,scope;token2|actor_id2|scope
# Broad local-agent example:
TROVE_SERVICE_TOKENS=local-dev-token|local-agent|graph:admin

# Optional semantic search / embedding refresh.
# TROVE_EMBEDDING_PROVIDER=openai
# TROVE_EMBEDDING_MODEL=text-embedding-3-small
# TROVE_EMBEDDING_DIMENSIONS=1536
# TROVE_EMBEDDING_JOB_LIMIT=256
# OPENAI_API_KEY=

# Write-time reconciliation (reconcile_node jobs) runs on every write. The
# LLM judge is OPT-IN: set to 1 to enable it. Cost is bounded by construction
# (backlog #27): candidates farther than TROVE_RECONCILE_SKIP_DISTANCE are
# gated out without a call, survivors are judged in ONE batched call per
# write, and TROVE_RECONCILE_JUDGE_BUDGET caps calls per owner per hour.
#
# With it off, reconciliation still runs a conservative heuristic that flags
# near-identical titles and never mutates the graph — nothing is lost silently.
# TROVE_RECONCILE_JUDGE=1          # also accepts true/yes/on; anything else is off
# TROVE_RECONCILE_JUDGE_MODEL=gpt-4o-mini
# TROVE_RECONCILE_SKIP_DISTANCE=0.45   # calibrated; lowering below ~0.42 loses real supersessions
# TROVE_RECONCILE_JUDGE_BUDGET=100     # judge calls per owner per hour; 0 disables the cap

# Graph chat — the dashboard's "ask the graph" panel (POST /v1/graph-chat).
# The traversal it streams IS a recall, and needs no model: with this off the
# endpoint still streams every retrieval stage and returns the pack, and the
# panel says in so many words that no model is configured. The flag buys the
# prose, nothing else.
#
# Any OpenAI-compatible endpoint works, and the intended ones are cheap. Point
# OPENAI_BASE_URL at the provider and name its model:
#   DeepSeek  OPENAI_BASE_URL=https://api.deepseek.com/v1     TROVE_CHAT_MODEL=deepseek-chat
#   Z.ai GLM  OPENAI_BASE_URL=https://api.z.ai/api/paas/v4    TROVE_CHAT_MODEL=glm-4-flash
# Those, and the gpt-4o-mini default, all speak the classic body. A REASONING
# model instead wants max_completion_tokens + reasoning_effort and REJECTS
# temperature; either mismatch is a hard 400, so the shape is configured rather
# than guessed from the model name. Point at one with, e.g.
#   TROVE_CHAT_MODEL=gpt-5.6-luna  TROVE_CHAT_REASONING_EFFORT=low
# TROVE_GRAPH_CHAT=1               # also accepts true/yes/on; anything else is off
#   OpenRouter  OPENROUTER_API_KEY=...  (one key, many cheap models; picked up
#               automatically, base URL and model default to OpenRouter's)
# TROVE_CHAT_MODEL=meta/muse-spark-1.3-contributor
# TROVE_CHAT_MODEL=gpt-4o-mini
# TROVE_CHAT_REASONING_EFFORT=none # none for a classic chat model; minimal|low|medium|high for a reasoning one
# TROVE_CHAT_TIMEOUT_MS=45000      # whole-answer deadline

# Read-time reranking of the recall candidate head. Opt-in: it adds an LLM call
# to an interactive read. Fails open — a timeout or a bad reply just keeps the
# ordering recall had before.
# TROVE_RECALL_RERANK=1
# TROVE_RECALL_RERANK_MODEL=gpt-4o-mini
# TROVE_RECALL_RERANK_TIMEOUT_MS=2000
# Reranking runs on every recall, so it is the most price-sensitive LLM call
# here. With nothing below set it uses OPENAI_API_KEY at OPENAI_BASE_URL, which
# is also the embeddings key and must stay pointed at OpenAI. Set both of these
# to move ONLY reranking to a cheaper OpenAI-compatible provider, and name the
# model explicitly — the gpt-4o-mini default is an OpenAI id.
# TROVE_RERANK_API_KEY=sk-or-...
# TROVE_RERANK_BASE_URL=https://openrouter.ai/api/v1

# Background job worker (embeddings, lint, projections). On by default;
# set to 0 to require manual draining via npm run jobs:run.
# TROVE_AUTORUN_JOBS=1
# TROVE_JOB_INTERVAL_MS=30000

# Clerk auth (hosted dashboard + per-user keys + OAuth connector). Optional
# locally; required for the claude.ai OAuth connector. See docs/oauth.md.
# CLERK_SECRET_KEY=sk_live_...
# CLERK_PUBLISHABLE_KEY=pk_live_...        # or VITE_CLERK_PUBLISHABLE_KEY (build-time)
# TROVE_ADMIN_EMAILS=you@example.com
