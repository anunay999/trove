PORT=8787
DATABASE_URL=postgres://graphmind:graphmind@localhost:5432/graphmind
RAW_BLOB_BUCKET=graphmind-raw

# Optional locally. Required in production.
# Format: token|actor_id|scope,scope;token2|actor_id2|scope
# Broad local-agent example:
GRAPHMIND_SERVICE_TOKENS=local-dev-token|local-agent|graph:admin

# Optional semantic search / embedding refresh.
# GRAPHMIND_EMBEDDING_PROVIDER=openai
# GRAPHMIND_EMBEDDING_MODEL=text-embedding-3-small
# GRAPHMIND_EMBEDDING_DIMENSIONS=1536
# GRAPHMIND_EMBEDDING_JOB_LIMIT=24
# OPENAI_API_KEY=
