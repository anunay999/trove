PORT=8787
DATABASE_URL=postgres://trove:trove@localhost:5433/trove
RAW_BLOB_BUCKET=trove-raw

# Optional locally. Required in production.
# Format: token|actor_id|scope,scope;token2|actor_id2|scope
# Broad local-agent example:
TROVE_SERVICE_TOKENS=local-dev-token|local-agent|graph:admin

# Optional semantic search / embedding refresh.
# TROVE_EMBEDDING_PROVIDER=openai
# TROVE_EMBEDDING_MODEL=text-embedding-3-small
# TROVE_EMBEDDING_DIMENSIONS=1536
# TROVE_EMBEDDING_JOB_LIMIT=24
# OPENAI_API_KEY=

# Background job worker (embeddings, lint, projections). On by default;
# set to 0 to require manual draining via npm run jobs:run.
# TROVE_AUTORUN_JOBS=1
# TROVE_JOB_INTERVAL_MS=30000

# Clerk auth (hosted dashboard + per-user keys + OAuth connector). Optional
# locally; required for the claude.ai OAuth connector. See docs/oauth.md.
# CLERK_SECRET_KEY=sk_live_...
# CLERK_PUBLISHABLE_KEY=pk_live_...        # or VITE_CLERK_PUBLISHABLE_KEY (build-time)
# TROVE_ADMIN_EMAILS=you@example.com
